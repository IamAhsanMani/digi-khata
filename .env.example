# GEMINI_API_KEY: Injected by AI Studio if Gemini calls are needed
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current deployed URL
APP_URL="MY_APP_URL"

# Supabase Auth & Database Credentials
# Client-safe credentials (prefixed with VITE_)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
VITE_SUPABASE_STORAGE_BUCKET="digikhata-media"

# Server-only credential. NEVER add this to VITE_ variables or browser code.
# Configure this as a Supabase Edge Function secret instead of shipping it to the frontend.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not required in .env.local.

# Cloudflare R2 Storage (Section 16 - Attachments & Documents)
CLOUDFLARE_R2_ACCOUNT_ID="your-r2-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="digikhata-private-attachments"
